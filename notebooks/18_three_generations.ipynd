        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import scipy.sparse as sp\n",
        "import scipy.sparse.linalg as spla\n",
        "\n",
        "plt.rcParams.update({'font.size': 12, 'figure.figsize': (10, 5)})\n",
        "np.set_printoptions(precision=4, suppress=True)\n",
        "\n",
        "# Pauli matrices / Матрицы Паули\n",
        "s1 = np.array([[0, 1], [1, 0]])\n",
        "s2 = np.array([[0, -1j], [1j, 0]])\n",
        "s3 = np.diag([1, -1])"
      ],
      "metadata": {
        "id": "gBfkZzPs2BXD"
      },
      "execution_count": 71,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# Part A — Momentum-space dispersion (clean doubling test)\n",
        "# Часть A — Дисперсия в импульсном пространстве (тест на удвоение)\n",
        "# ============================================================\n",
        "def H_k(kx, ky, m0, r):\n",
        "    \"\"\"2D Wilson-Dirac in momentum space.\"\"\"\n",
        "    m_eff = m0 + r * (2 - np.cos(kx) - np.cos(ky))\n",
        "    return -1j * s1 * np.sin(kx) - 1j * s2 * np.sin(ky) + m_eff * s3\n",
        "\n",
        "m0 = 0.1\n",
        "kx_vals = np.linspace(-np.pi, np.pi, 300)\n",
        "\n",
        "fig_A1, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "for ax, r, title in [(axes[0], 0.0, 'A1: Naive (r=0) — 4 Dirac points'),\n",
        "                     (axes[1], 1.0, 'A1: Wilson (r=1) — 1 Dirac point')]:\n",
        "    for ky_label, ky in [('ky=0', 0.0), ('ky=pi', np.pi)]:\n",
        "        E_plus, E_minus = [], []\n",
        "        for kx in kx_vals:\n",
        "            eigs = np.linalg.eigvalsh(H_k(kx, ky, m0, r))\n",
        "            E_minus.append(eigs[0])\n",
        "            E_plus.append(eigs[1])\n",
        "        ax.plot(kx_vals, E_plus, label=f'+ ({ky_label})', lw=2)\n",
        "        ax.plot(kx_vals, E_minus, label=f'- ({ky_label})', lw=2)\n",
        "    ax.axhline(0, color='k', ls=':', lw=1)\n",
        "    ax.set_xlabel('k_x')\n",
        "    ax.set_ylabel('E')\n",
        "    ax.set_title(title)\n",
        "    ax.legend(fontsize=9)\n",
        "    ax.grid(alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
